# Copy to .env and fill locally; never commit the actual key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tritonai-api.ucsd.edu/v1
# TRITONAI_API_KEY / TRITONAI_BASE_URL are also supported and take precedence.
# Confirm this model is returned by `mas-recovery models` for YOUR key.
TRITONAI_MODEL=api-glm-5.3-flash
